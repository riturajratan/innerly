{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knowyourmind",
  "account_id": "72dbaa9606b6dd363b5a50e3e0d656c4",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth-config.mjs"]
  },
  "vars": {
    "APP_ORIGIN": "https://knowyourmind.ai",
    "CLERK_PUBLISHABLE_KEY": "",
    "CLERK_ISSUER": "",
    "BILLING_ENABLED": "false",
    "BILLING_PLANS": "[]"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "knowyourmind-production",
    "database_id": "bb0c3e32-1e6d-4c07-b170-d22a50d7959a",
    "migrations_dir": "migrations"
  }],
  "observability": { "enabled": false }
}
