{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knowyourmind",
  "account_id": "72dbaa9606b6dd363b5a50e3e0d656c4",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": [
    "nodejs_compat"
